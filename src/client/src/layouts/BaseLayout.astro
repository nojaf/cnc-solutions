---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import type { Culture } from "../lib/umbraco";

interface Props {
  culture: Culture;
  currentPageId: number;
  urls: { nl: string; en: string; fr: string };
  seo: {
    title: string;
    description?: string;
    keywords?: string;
    lang?: string;
  };
  mainClass?: string;
}

const { culture, currentPageId, urls, seo, mainClass = "" } = Astro.props;
---

<!doctype html>
<html lang={seo.lang ?? culture}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <SEO {...seo} />
    <ClientRouter />
  </head>
  <body>
    <Navigation culture={culture} currentPageId={currentPageId} urls={urls} />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer culture={culture} />
    <CookieConsent culture={culture} />
  </body>
</html>
