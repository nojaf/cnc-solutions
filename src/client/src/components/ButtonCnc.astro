---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href?: string;
  type?: "button" | "submit";
}

const { href, type, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const clipPath =
  "polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%)";
---

<Tag
  href={href}
  type={!href ? type : undefined}
  {...rest}
  class="btn-cnc group relative inline-block no-underline p-0.5 text-lg leading-7"
  style={`clip-path: ${clipPath};`}
>
  <span
    class="block bg-primary group-hover:bg-white py-2 px-6 text-white group-hover:text-primary"
    style={`clip-path: ${clipPath};`}
  >
    <slot />
  </span>
</Tag>

<style>
  .btn-cnc {
    background-color: var(--color-primary);
  }
</style>
