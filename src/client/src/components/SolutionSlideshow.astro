---
import { getImage } from "astro:assets";
import { getImageParams } from "../lib/umbraco";

export interface SlideshowSlide {
  altText: string;
  image: {
    "mobile-portrait": string;
    "mobile-landscape": string;
    tablet: string;
    desktop: string;
    "large-desktop": string;
  };
}

interface Props {
  id: string;
  color: "dark" | "light";
  slides: SlideshowSlide[];
}

const { id, color, slides } = Astro.props;

const images = await Promise.all(
  slides.map(async (s) => ({
    mobilePortrait: await getImage(getImageParams(s.image["mobile-portrait"])),
    mobileLandscape: await getImage(
      getImageParams(s.image["mobile-landscape"]),
    ),
    tablet: await getImage(getImageParams(s.image.tablet)),
    desktop: await getImage(getImageParams(s.image.desktop)),
    largeDesktop: await getImage(getImageParams(s.image["large-desktop"])),
  })),
);

// The old site drew the arrows and dots in white on a dark row and in the
// primary colour on a light row.
const dark = color === "dark";
const arrow = "w-0 h-0 border-y-10 border-transparent";
---

<div class="solution-slideshow relative" id={id}>
  <div class="overflow-hidden">
    <div
      class="slideshow-track flex transition-transform duration-600 ease-in-out"
    >
      {
        slides.map((s, i) => (
          <a
            href={images[i].desktop.src}
            class="slideshow-slide block w-full shrink-0 cursor-zoom-in"
            data-alt={s.altText}
          >
            <picture>
              <source
                media="(min-width: 75em)"
                srcset={images[i].largeDesktop.src}
              />
              <source
                media="(min-width: 62em)"
                srcset={images[i].desktop.src}
              />
              <source media="(min-width: 48em)" srcset={images[i].tablet.src} />
              <source
                media="(min-width: 34em)"
                srcset={images[i].mobileLandscape.src}
              />
              <img
                src={images[i].mobilePortrait.src}
                alt={s.altText}
                class="block mx-auto w-full"
              />
            </picture>
          </a>
        ))
      }
    </div>
  </div>

  {
    /* Dots sit 14px below the image, overlapping the text block's top margin. */
  }
  <div
    class="slideshow-dots absolute inset-x-0 bottom-4 flex justify-center gap-2.5 py-2.5 translate-y-12.5"
  >
    {
      slides.map((_, i) => (
        <button
          class:list={[
            "slideshow-dot relative w-2.5 h-2.5 cursor-pointer",
            dark ? "bg-white" : "bg-dark",
          ]}
          data-slide-to={i}
          aria-label={`Slide ${i + 1}`}
        >
          <span
            class:list={[
              "absolute inset-0 w-0 h-0 border-b-10 border-l-10 border-transparent border-b-primary",
              i === 0 ? "block" : "hidden",
            ]}
          />
        </button>
      ))
    }
  </div>

  <button
    class="slideshow-prev absolute inset-y-0 left-0 z-10 flex w-3/20 items-center justify-center opacity-50 hover:opacity-90 cursor-pointer"
    aria-label="Previous"
  >
    <span
      class:list={[
        arrow,
        "border-l-0 border-r-15",
        dark ? "border-r-white" : "border-r-primary",
      ]}></span>
  </button>
  <button
    class="slideshow-next absolute inset-y-0 right-0 z-10 flex w-3/20 items-center justify-center opacity-50 hover:opacity-90 cursor-pointer"
    aria-label="Next"
  >
    <span
      class:list={[
        arrow,
        "border-r-0 border-l-15",
        dark ? "border-l-white" : "border-l-primary",
      ]}></span>
  </button>
</div>

<script>
  function initSlideshow(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>(".slideshow-track");
    const slides = [
      ...root.querySelectorAll<HTMLAnchorElement>(".slideshow-slide"),
    ];
    const dots = root.querySelectorAll<HTMLElement>(".slideshow-dot");
    const count = slides.length;
    if (!track || count === 0) return;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(index: number) {
      current = (index + count) % count;
      track!.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        d.firstElementChild?.classList.toggle("block", i === current);
        d.firstElementChild?.classList.toggle("hidden", i !== current);
      });
    }

    function restart() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => show(current + 1), 5000);
    }

    root.querySelector(".slideshow-prev")?.addEventListener("click", () => {
      show(current - 1);
      restart();
    });
    root.querySelector(".slideshow-next")?.addEventListener("click", () => {
      show(current + 1);
      restart();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        show(i);
        restart();
      }),
    );

    // Lightbox: the old site opened the desktop crop in a modal gallery.
    slides.forEach((slide, i) =>
      slide.addEventListener("click", (e) => {
        e.preventDefault();
        openLightbox(slides, i);
      }),
    );

    restart();
  }

  function openLightbox(slides: HTMLAnchorElement[], start: number) {
    let index = start;
    const dialog = document.createElement("dialog");
    dialog.className =
      "m-auto max-w-[90vw] p-0 bg-transparent backdrop:bg-black/70 outline-none";
    dialog.innerHTML = `
      <img class="block max-h-[90vh] max-w-full" />
      <button class="lightbox-prev absolute inset-y-0 left-0 w-1/4 cursor-pointer" aria-label="Previous"></button>
      <button class="lightbox-next absolute inset-y-0 right-0 w-1/4 cursor-pointer" aria-label="Next"></button>
    `;
    const img = dialog.querySelector("img")!;
    function render() {
      img.src = slides[index].href;
      img.alt = slides[index].dataset.alt ?? "";
    }
    function step(delta: number) {
      index = (index + delta + slides.length) % slides.length;
      render();
    }
    dialog.querySelector(".lightbox-prev")!.addEventListener("click", (e) => {
      e.stopPropagation();
      step(-1);
    });
    dialog.querySelector(".lightbox-next")!.addEventListener("click", (e) => {
      e.stopPropagation();
      step(1);
    });
    dialog.addEventListener("click", () => dialog.close());
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
    dialog.addEventListener("close", () => dialog.remove());
    render();
    document.body.append(dialog);
    dialog.showModal();
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>(".solution-slideshow")
      .forEach(initSlideshow);
  });
</script>
