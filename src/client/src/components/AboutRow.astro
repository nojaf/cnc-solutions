---
import type { Culture } from "../lib/umbraco";
import { pageInCulture } from "../lib/umbraco";
import { getCollection } from "astro:content";
import underlineWhite from "../assets/underline-white.png";
import Video from "./Video.astro";
import ButtonCnc from "./ButtonCnc.astro";

interface Props {
  page: Record<string, any>;
  culture: Culture;
}

const { page, culture } = Astro.props;
const row = pageInCulture(culture, page);

// Resolve linkUrl (umbraco ID) to an actual URL
let linkHref: string | null = null;
if (row.linkUrl && row.linkText) {
  const collections = await Promise.all([
    getCollection("home"),
    getCollection("solutions"),
    getCollection("solution"),
    getCollection("products"),
    getCollection("product"),
    getCollection("cases"),
    getCollection("case"),
    getCollection("about"),
    getCollection("team"),
    getCollection("news"),
    getCollection("contact"),
  ]);
  for (const col of collections) {
    const match = col.find((item: any) => item.data.umbracoId === row.linkUrl);
    if (match) {
      const resolved = pageInCulture(culture, match.data);
      linkHref = resolved.url as string;
      break;
    }
  }
}

const imageRight = row.imageRight ?? false;
---

<section>
  <div class="mx-auto p-0 md:max-w-180 lg:max-w-240 xl:max-w-285">
    <div class:list={["flex flex-wrap", imageRight && "md:flex-row-reverse"]}>
      <div class="w-full md:w-1/2">
        {
          row.image && (
            <picture>
              <source media="(min-width: 75em)" srcset={row.image.desktop} />
              <source media="(min-width: 62em)" srcset={row.image.tablet} />
              <source media="(min-width: 48em)" srcset={row.image.tablet} />
              <source media="(min-width: 34em)" srcset={row.image.medium} />
              <img
                class="w-full"
                src={row.image.small}
                srcset={row.image.small}
                alt={row.altText || ""}
              />
            </picture>
          )
        }
        {
          row.videoId && (
            <Video videoId={row.videoId} altText={row.altText || "Video"} />
          )
        }
      </div>
      <div class="w-full md:w-1/2">
        <div
          class="flex flex-col justify-center items-center h-full px-4 py-4 text-center"
        >
          {
            row.aboveTitle && (
              <h3 class="text-sm lg:text-2xl lg:leading-10 font-thin lg:font-light m-0">
                {row.aboveTitle}
              </h3>
            )
          }
          <h2
            class="uppercase text-[30px] leading-9 lg:text-5xl lg:leading-12 font-bold mb-2"
          >
            {row.title}
          </h2>
          <img src={underlineWhite.src} alt="" class="block mb-8 w-6" />
          {row.lead && <div set:html={row.lead} />}
          {
            linkHref && row.linkText && (
              <ButtonCnc href={linkHref}>{row.linkText}</ButtonCnc>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
