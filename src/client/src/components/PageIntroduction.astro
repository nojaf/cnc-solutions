---
import underlineWhite from "../assets/underline-white.png";

interface Props {
  aboveTitle?: string | null;
  title: string;
  lead?: string | null;
  /** Gatsby lowercased the above-title on every page except contact. */
  lowercase?: boolean;
}

const { aboveTitle, title, lead, lowercase = true } = Astro.props;
---

<section>
  <div class="mx-auto px-4 sm:max-w-135 md:max-w-180 lg:max-w-240 xl:max-w-285">
    <div class="text-center mt-12 mb-2">
      {aboveTitle && (
        <h2
          class:list={[
            "text-sm leading-4 lg:text-2xl lg:leading-10 lg:font-light font-thin p-0 m-0",
            { lowercase },
          ]}
        >
          {aboveTitle}
        </h2>
      )}
      <div class="text-center">
        <h1 class="uppercase text-3xl leading-9 lg:text-5xl lg:leading-12 font-bold mb-0">
          {title}
        </h1>
        <img
          src={underlineWhite.src}
          alt=""
          class="intro-underline block mx-auto w-6 mb-8 opacity-0 transition-opacity duration-600 ease-in"
        />
        {lead && (
          <div
            id="lead"
            class="cms-content text-left lg:w-1/2 lg:mx-auto lg:mb-14"
            set:html={lead}
          />
        )}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const img = document.querySelector<HTMLImageElement>(".intro-underline");
    if (!img) return;
    function reveal() {
      img!.style.opacity = "1";
    }
    if (img.complete) {
      reveal();
    } else {
      img.addEventListener("load", reveal);
    }
  });
</script>
