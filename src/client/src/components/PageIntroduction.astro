---
import underlineWhite from "../assets/underline-white.png";

interface Props {
  aboveTitle?: string;
  title: string;
  lead?: string;
}

const { aboveTitle, title, lead } = Astro.props;
---

<section>
  <div class="mx-auto px-4 lg:max-w-240 xl:max-w-285">
    <div class="text-center mt-12 mb-2">
      {
        aboveTitle && (
          <h2 class="text-sm lg:text-2xl lg:leading-10 lg:font-light font-thin p-0 m-0 lowercase">
            {aboveTitle}
          </h2>
        )
      }
      <div class="inline-block text-center">
        <h1
          class="uppercase text-[30px] leading-9 lg:text-5xl lg:leading-12 font-bold mb-0"
        >
          {title}
        </h1>
        <img
          src={underlineWhite.src}
          alt=""
          class:list={[
            "intro-underline block mx-auto w-6 opacity-0 transition-opacity duration-600 ease-in",
            lead ? "mb-8" : "mb-0",
          ]}
        />
        {lead && <div id="lead" class="cms-content" set:html={lead} />}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const img = document.querySelector<HTMLImageElement>(".intro-underline");
    if (!img) return;
    function reveal() {
      img!.style.opacity = "1";
    }
    if (img.complete) {
      reveal();
    } else {
      img.addEventListener("load", reveal);
    }
  });
</script>
